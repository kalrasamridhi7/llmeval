# LLMEval Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key (Required for OpenAI models like gpt-4o-mini, gpt-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Required for Anthropic models like claude-sonnet-4-6)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
